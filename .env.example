# Neon Postgres. Get it from the Neon console or: neon connection-string
DATABASE_URL=""

# scrypt hash of the /admin password, as "salt:hash".
# Regenerate with: node scripts/set-password.mjs
ADMIN_PASSWORD_HASH=""

# Random 32 bytes, base64url. Signs the admin session cookie.
SESSION_SECRET=""

# Neon object storage (branchable, S3-compatible). Bucket is public-read.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="art"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
